# Email Draft Agent — setup values
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.
#
# Claude Code does not read this file into the skill. Each value below
# matches one double-brace placeholder in .claude/skills/email-draft/SKILL.md and
# must be written into that file (the first-run prompt in the README does
# this for you). Keep `.env` as the record of your setup, and as the place
# for any credentials your own email CLI or helper scripts need.

# ============================================================
# Email accounts the agent can draft from
# ============================================================
# {{INBOX_PRIMARY}}, {{INBOX_BOOKINGS}}, {{INBOX_RENTALS}}

INBOX_PRIMARY="info@yourhotel.com"
INBOX_BOOKINGS="bookings@yourhotel.com"
INBOX_RENTALS="rentals@yourhotel.com"

# ============================================================
# Email provider CLI
# ============================================================
# {{EMAIL_CLI}}: the command that reads mail and creates drafts for
# a given account. Reference setup uses a Google Workspace CLI (`gws`).

EMAIL_CLI="gws"

# ============================================================
# Draft helpers (you supply these; none ship with this repo)
# ============================================================
# {{DRAFT_REPLY_TOOL}}, {{DRAFT_NEW_TOOL}}: small wrappers around your
# provider's API that handle threading + HTML MIME parts cleanly.

DRAFT_REPLY_TOOL="tools/create_draft_reply.py"
DRAFT_NEW_TOOL="tools/create_draft_email.py"

# ============================================================
# Operator identity (used in sign-offs)
# ============================================================
# {{OPERATOR_NAME}}, {{HOTEL_NAME}}

OPERATOR_NAME=""
HOTEL_NAME=""
