# Email Draft Agent — environment variables
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.

# ============================================================
# Email accounts the agent can draft from
# ============================================================
# Referenced inside .claude/skills/email-draft/SKILL.md via the
# {{INBOX_*}} placeholders.

INBOX_PRIMARY="info@yourhotel.com"
INBOX_BOOKINGS="bookings@yourhotel.com"
INBOX_RENTALS="rentals@yourhotel.com"

# ============================================================
# Email provider CLI
# ============================================================
# Wrapper that switches between accounts and creates drafts.
# Reference setup uses the Google Workspace CLI (`gws`).

EMAIL_CLI="gws"

# ============================================================
# Optional draft helpers
# ============================================================
# Most setups have a small wrapper around the provider's API
# that handles threading + HTML MIME parts cleanly.

DRAFT_REPLY_TOOL="tools/create_draft_reply.py"
DRAFT_NEW_TOOL="tools/create_draft_email.py"

# ============================================================
# Operator identity (used in sign-offs)
# ============================================================
OPERATOR_NAME=""
HOTEL_NAME=""
