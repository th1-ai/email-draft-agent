{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/runs/**)",
      "Bash({{EMAIL_CLI}} *)",
      "Bash({{DRAFT_REPLY_TOOL}} *)",
      "Bash({{DRAFT_NEW_TOOL}} *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(/AUTONOMY.md)",
      "Edit(/.claude/**)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/autonomy-guard.py",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
